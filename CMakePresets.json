{
    "version": 7,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 27,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_C_STANDARD": "17",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/LabVIEW"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/windows-$penv{Platform}",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "$penv{Platform}-windows-static"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-x64-debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/linux-x64",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-desktop"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-release",
            "inherits": "windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-x64-release",
            "inherits": "linux-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "nilrt-armv7a-cross",
            "inherits": "linux-x64-release",
            "binaryDir": "${sourceDir}/build/nilrt-armv7a",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "armv7a-nilrt-linux-ci",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/scripts/toolchains/nilrt-armv7a.cmake"
            }
        },
        {
            "name": "ci",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}",
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "$penv{CI}",
                "rhs": "true"
            }
        },
        {
            "name": "ci-windows-static-x86",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x86-windows-static-ci"
            }
        },
        {
            "name": "ci-windows-static-x64",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-ci"
            }
        },
        {
            "name": "ci-linux-x64",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-ci"
            }
        },
        {
            "name": "ci-linux-armv7a-nilrt",
            "inherits": "nilrt-armv7a-cross",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "armv7a-nilrt-linux-ci"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "targets": "install",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "targets": "install",
            "configuration": "Release"
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug",
            "targets": "install",
            "configuration": "Debug"
        },
        {
            "name": "linux-x64-release",
            "configurePreset": "linux-x64-release",
            "targets": "install",
            "configuration": "Release"
        },
        {
            "name": "ci-windows-static-x86",
            "configuration": "Release",
            "targets": "install",
            "configurePreset": "ci-windows-static-x86"
        },
        {
            "name": "ci-windows-static-x64",
            "configuration": "Release",
            "targets": "install",
            "configurePreset": "ci-windows-static-x64"
        },
        {
            "name": "ci-linux-x64",
            "configuration": "Release",
            "targets": "install",
            "configurePreset": "ci-linux-x64"
        },
        {
            "name": "ci-linux-armv7a-nilrt",
            "configuration": "Release",
            "targets": "install",
            "configurePreset": "ci-linux-armv7a-nilrt"
        }  
    ]
}